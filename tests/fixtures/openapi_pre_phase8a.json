                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversion Rate"
          },
          "n_records": {
            "exclusiveMinimum": 0.0,
            "title": "N Records",
            "type": "integer"
          },
          "tier_order": {
            "anyOf": [
              {
                "enum": [
                  1,
                  2,
                  3
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier Order"
          }
        },
        "required": [
          "tier_order",
          "budget_tier",
          "n_records",
          "conversion_rate"
        ],
        "title": "TierRow",
        "type": "object"
      },
      "UnobservedBudgetWarning": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "unobserved_budget_level",
            "title": "Code",
            "type": "string"
          },
          "feature": {
            "const": "ad_budget",
            "title": "Feature",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "value": {
